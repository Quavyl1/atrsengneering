---
import {site,nav} from '../data/site';
import '../styles/global.css';

const {
  title,
  description='ATRS Engineering Consultants provides traffic engineering, road safety, public transport and mobility consultancy across Kenya and East Africa.',
  ogImage='/og-default.svg',
  ogType='website',
  noindex=false,
  schema=[]
}=Astro.props;

const canonicalUrl=new URL(Astro.url.pathname,site.domain).href;
const schemas=Array.isArray(schema)?schema:[schema];

const organization={
  '@context':'https://schema.org',
  '@type':'Organization',
  name:site.name,
  url:site.domain,
  email:site.email,
  address:{
    '@type':'PostalAddress',
    streetAddress:site.address,
    postalCode:'00100',
    addressLocality:'Nairobi',
    addressCountry:'KE'
  }
};

const breadcrumb={
  '@context':'https://schema.org',
  '@type':'BreadcrumbList',
  itemListElement:[
    {'@type':'ListItem',position:1,name:'Home',item:site.domain+'/'},
    ...(Astro.url.pathname!=='/'?[{'@type':'ListItem',position:2,name:title||site.name,item:canonicalUrl}]:[])
  ]
};

const graph=Astro.url.pathname==='/'?
  [organization,{'@context':'https://schema.org','@type':'WebSite',name:site.name,url:site.domain}]:
  [organization,breadcrumb];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#0c1824">
<meta name="description" content={description}>
<meta name="robots" content={noindex?'noindex,follow':'index,follow'}>
<link rel="canonical" href={canonicalUrl}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<title>{title ? title+' | ATRS Engineering' : site.name}</title>
<meta property="og:title" content={title ? title+' | ATRS Engineering' : site.name}>
<meta property="og:description" content={description}>
<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:site_name" content={site.name}>
<meta property="og:locale" content="en_KE">
<meta property="og:image" content={new URL(ogImage,site.domain).href}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title ? title+' | ATRS Engineering' : site.name}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={new URL(ogImage,site.domain).href}>
{[...graph,...schemas].map(item=><script type="application/ld+json" set:html={JSON.stringify(item)}></script>)}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="container nav-wrap">
    <a class="logo" href="/" aria-label="ATRS Engineering home">
      <span class="logo-mark">A</span><span>ATRS<span class="logo-dot">.</span>ENG</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {nav.map(([label,href])=><a href={href} class={Astro.url.pathname.startsWith(href as string)&&href!=='/'?'active':''}>{label}</a>)}
    </nav>
    <a class="nav-cta" href="/contact/">Request a proposal</a>
    <details class="mobile-nav">
      <summary aria-label="Open menu">Menu</summary>
      <nav>
        {nav.map(([label,href])=><a href={href}>{label}</a>)}
        <a class="btn btn-gold" href="/contact/">Request a proposal</a>
      </nav>
    </details>
  </div>
</header>

<main id="main"><slot/></main>

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a class="logo logo-light" href="/"><span class="logo-mark">A</span><span>ATRS<span class="logo-dot">.</span>ENG</span></a>
      <p class="footer-lead">Traffic engineering, road safety and mobility expertise for safer and better-connected communities.</p>
      <p>{site.address}<br>{site.postal}</p>
      <a href={'mailto:'+site.email}>{site.email}</a>
    </div>
    <div>
      <h3>Services</h3>
      <a href="/services/traffic-engineering/">Traffic Engineering</a>
      <a href="/services/road-safety-engineering/">Road Safety Engineering</a>
      <a href="/services/public-transport-brt/">Public Transport / BRT</a>
      <a href="/services/data-surveys-analysis/">Data & Surveys</a>
    </div>
    <div>
      <h3>Explore</h3>
      <a href="/projects/">Projects</a>
      <a href="/insights/">Insights</a>
      <a href="/about/">About ATRS</a>
      <a href="/partner/">Partner with us</a>
      <a href="/contact/">Contact</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} ATRS Engineering Consultants Limited</span>
    <span><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></span>
  </div>
</footer>
</body>
</html>
---
import Base from '../layouts/Base.astro';
---
<Base title="Contact / Request a Proposal"><section class="hero"><div class="container"><span class="eyebrow">Contact</span><h1>Tell ATRS what you need.</h1><p>Use this route for a project enquiry, technical scope or proposal request.</p></div></section><section class="section"><div class="container"><div class="grid"><div><span class="tag">Direct contact</span><h2 style="font-size:2rem">ATRS Engineering Consultants Limited</h2><p>7th Floor, The Oval, Westlands, Nairobi<br>P.O. Box 577-00100, Nairobi</p><p><a href="mailto:info@atrseng.co.ke">info@atrseng.co.ke</a></p></div><form class="card form" action="/api/enquiry" method="post"><div class="field"><label>Name<input name="name" required></label></div><div class="field"><label>Organisation<input name="organisation" required></label></div><div class="field"><label>Email<input name="email" type="email" required></label></div><div class="field"><label>Project / proposal request<textarea name="scope" required></textarea></label></div><input type="hidden" name="form" value="proposal-request"><button class="btn gold" type="submit">Send request</button><p class="note">Production submission handling will be enabled after the email provider and Turnstile are configured.</p></form></div></div></section></Base>
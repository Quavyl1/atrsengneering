---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
const schema={'@context':'https://schema.org','@type':'ContactPage',name:'Contact ATRS Engineering Consultants',url:'https://atrseng.co.ke/contact/'};
---
<Base title="Contact" description="Contact ATRS Engineering Consultants in Nairobi for traffic engineering, road safety, BRT, mobility and traffic impact assessment services." schema={schema}>
<section class="hero"><div class="container"><span class="eyebrow">Contact</span><h1>Tell us what your project needs to decide.</h1><p>Send the brief, location, scope and timeline. We will use that information to understand the appropriate technical support.</p></div></section>
<section class="section"><div class="container contact-grid"><div class="contact-card"><div class="icon-row"><Icon name="partner"/><span class="eyebrow">ATRS Engineering</span></div><h2>Start with the brief.</h2><p>For proposals, partnerships and project enquiries:</p><p><a href="mailto:info@atrseng.co.ke">info@atrseng.co.ke</a></p><p>7th Floor, The Oval, Westlands, Nairobi<br>P.O. Box 577-00100, Nairobi</p><div class="notice" style="margin-top:24px">Please do not send confidential or sensitive project information until an appropriate engagement channel has been agreed.</div></div>
<form class="form" action="mailto:info@atrseng.co.ke" method="post" enctype="text/plain"><div class="form-grid"><div class="field"><label for="name">Name</label><input id="name" name="Name" required></div><div class="field"><label for="company">Company / organisation</label><input id="company" name="Company"></div><div class="field"><label for="email">Email</label><input id="email" type="email" name="Email" required></div><div class="field"><label for="phone">Phone</label><input id="phone" name="Phone"></div><div class="field full"><label for="scope">Project scope</label><select id="scope" name="Project type"><option>Traffic engineering</option><option>Road safety</option><option>Traffic impact assessment</option><option>BRT / public transport</option><option>Data / surveys / analysis</option><option>Partnership / tender</option><option>Other</option></select></div><div class="field full"><label for="message">Brief</label><textarea id="message" name="Brief" placeholder="Location, project type, required scope and timeline"></textarea></div><div class="field full"><button class="btn btn-dark" type="submit">Send enquiry →</button></div></div></form></div></section>
</Base>
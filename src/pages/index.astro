---
import Base from '../layouts/Base.astro'; import {services,projects,insights} from '../data/content';
---
<Base title="Traffic, Road Safety & Awareness Consultancy"><section class="hero"><div class="container"><span class="eyebrow">Traffic · Road Safety · Awareness</span><h1>Engineering safer movement and better-connected communities.</h1><p>ATRS Engineering Consultants provides practical, evidence-based solutions across traffic engineering, road safety and awareness.</p><div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:24px"><a class="btn gold" href="/contact/">Request a proposal</a><a class="btn darkbtn" style="border-color:#fff;color:#fff" href="/projects/">View projects</a></div></div></section><section class="section"><div class="container"><div class="sectionhead"><div><span class="tag">Three pillars</span><h2>Focused expertise for transport decisions</h2></div><p>Engineering analysis connected to safer roads, efficient mobility and practical awareness.</p></div><div class="grid"><article class="card"><span class="pill">Traffic</span><h3>Traffic</h3><p>Assessment, forecasting, operations, access and network planning.</p></article><article class="card"><span class="pill">Road Safety</span><h3>Road Safety</h3><p>Risk review, safety assessment and engineering mitigation.</p></article><article class="card"><span class="pill">Awareness</span><h3>Awareness</h3><p>Road-user education and awareness programmes linked to evidence.</p></article></div></div></section><section class="section alt"><div class="container"><div class="sectionhead"><div><span class="tag">Core services</span><h2>What we do</h2></div><a class="btn darkbtn" href="/services/">All services</a></div><div class="grid">{services.map(s=><article class="card"><span class="pill">{s.pillar}</span><h3>{s.title}</h3><p>{s.summary}</p><a class="link" href={'/services/'+s.slug+'/'}>Explore service →</a></article>)}</div></div></section><section class="section"><div class="container"><div class="sectionhead"><div><span class="tag">Selected experience</span><h2>Project proof</h2></div><a class="btn darkbtn" href="/projects/">All projects</a></div><div class="grid">{projects.slice(0,3).map(p=><article class="card"><div class="meta"><span>{p.country}</span><span>·</span><span>{p.date}</span></div><h3>{p.title}</h3><p><strong>{p.client}</strong></p><p>{p.summary}</p><a class="link" href={'/projects/'+p.slug+'/'}>Read case study →</a></article>)}</div></div></section><section class="cta"><div class="container ctain"><div><span class="tag">Start a conversation</span><h2>Have a project, tender or partnership opportunity?</h2><p>Tell ATRS what you are planning and the technical support you need.</p></div><a class="btn darkbtn" href="/partner/">Partner with ATRS →</a></div></section></Base>
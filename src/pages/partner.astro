---
import Base from '../layouts/Base.astro';
---
<Base title="Partner with ATRS"><section class="hero"><div class="container"><span class="eyebrow">Partner with us</span><h1>Add traffic, road safety and awareness expertise to your bid.</h1><p>For lead consultants, contractors and development partners forming joint ventures or sub-consultancies.</p><a class="btn gold" href="/contact/">Discuss a bid</a></div></section><section class="section"><div class="container"><div class="grid"><article class="card"><span class="pill">Bundled scope</span><h2 style="font-size:1.6rem">Safety and awareness scope</h2><p>One team for audits, traffic inputs and awareness programmes.</p></article><article class="card"><span class="pill">References</span><h2 style="font-size:1.6rem">Delivered experience</h2><p>ATRS-appointed assignments and clearly identified key-personnel experience.</p></article><article class="card"><span class="pill">Local capacity</span><h2 style="font-size:1.6rem">Field and technical coordination</h2><p>Surveys, audits and technical coordination across East Africa.</p></article></div></div></section><section class="section alt"><div class="container"><span class="tag">Bid enquiry</span><h2>Tell us about the tender</h2><form class="card form" action="/api/enquiry" method="post"><div class="field"><label>Name<input name="name" required></label></div><div class="field"><label>Organisation<input name="organisation" required></label></div><div class="field"><label>Email<input name="email" type="email" required></label></div><div class="field"><label>Tender reference and deadline<input name="reference"></label></div><div class="field"><label>Scope needed<textarea name="scope" required></textarea></label></div><input type="hidden" name="form" value="bid-enquiry"><button class="btn gold" type="submit">Send enquiry</button><p class="note">Production submission handling will be connected to Cloudflare Turnstile and transactional email before launch.</p></form></div></section></Base>
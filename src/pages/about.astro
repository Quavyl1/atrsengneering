---
import Base from '../layouts/Base.astro';
import {services,projects} from '../data/content';
const schema={'@context':'https://schema.org','@type':'AboutPage',name:'About ATRS Engineering Consultants Limited',url:'https://atrseng.co.ke/about/'};
---
<Base title="About ATRS" description="About ATRS Engineering Consultants Limited, a traffic engineering, road safety and mobility consultancy based in Nairobi, Kenya." schema={schema}>
<section class="hero"><div class="container"><span class="eyebrow">About ATRS</span><h1>Engineering expertise focused on safer movement.</h1><p>ATRS Engineering Consultants Limited is a Nairobi-based consultancy focused on traffic engineering, road safety, public transport and mobility-related technical support.</p></div></section>
<section class="section"><div class="container split"><div><span class="tag">Our role</span><h2>Turn transport evidence into decisions.</h2><p>Transport projects often sit at the intersection of engineering, operations, safety, access and community movement. ATRS brings these considerations together through field evidence, analysis and practical recommendations.</p><p>The portfolio includes documented assignments in Kenya and Somalia, alongside clearly labelled key-personnel experience elsewhere in East Africa.</p></div><div class="feature-box"><span class="eyebrow">ATRS focus</span><h3 style="font-size:2rem">Traffic</h3><h3 style="font-size:2rem">Road Safety</h3><h3 style="font-size:2rem">Public Transport</h3><h3 style="font-size:2rem">Mobility & Awareness</h3></div></div></section>
<section class="section section-soft"><div class="container"><span class="tag">How we approach assignments</span><h2>Four principles.</h2><div class="grid" style="margin-top:30px"><article class="card"><span class="pill">01</span><h3>Evidence-led</h3><p>Use appropriate field and project evidence before making engineering recommendations.</p></article><article class="card"><span class="pill">02</span><h3>Decision-focused</h3><p>Structure analysis around the decision the client needs to make.</p></article><article class="card"><span class="pill">03</span><h3>Practical</h3><p>Translate technical findings into recommendations that can be understood and implemented.</p></article><article class="card"><span class="pill">04</span><h3>Transparent</h3><p>Clearly distinguish documented assignments from key-personnel experience and avoid unsupported claims.</p></article></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="tag">Capability map</span><h2>Services connected to project evidence.</h2></div></div><div class="grid">{services.map(s=><article class="card"><h3>{s.title}</h3><p>{s.summary}</p><a class="link" href={'/services/'+s.slug+'/'}>Explore →</a></article>)}</div></div></section>
<section class="cta"><div class="container cta-inner"><div><span class="tag">Work with ATRS</span><h2>Have a corridor, development or mobility challenge?</h2></div><a class="btn btn-dark" href="/contact/">Start a conversation →</a></div></section>
</Base>
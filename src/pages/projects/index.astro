---
import Base from '../../layouts/Base.astro';
import {projects} from '../../data/content';
const projectListSchema={'@context':'https://schema.org','@type':'ItemList',name:'ATRS Engineering Project Experience',itemListElement:projects.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.title,url:new URL('/projects/'+p.slug+'/','https://atrseng.co.ke').href}))};
---
<Base title="Projects" description="Selected ATRS traffic engineering, road safety, BRT and traffic impact assessment experience in Kenya, Somalia and East Africa." schema={projectListSchema}>
<section class="hero"><div class="container"><span class="eyebrow">Projects</span><h1>Selected traffic, road safety and mobility experience.</h1><p>Case studies are organised around the technical questions clients search for: traffic engineering, road safety, BRT, traffic impact assessment, development access and traffic modelling.</p></div></section>
<section class="section"><div class="container"><div class="grid">{projects.map(p=><article class="card"><div class="meta"><span>{p.country}</span><span>·</span><span>{p.date}</span></div><span class="pill">{p.category}</span><h2 style="font-size:1.55rem">{p.title}</h2><p><strong>{p.client}</strong></p><p>{p.summary}</p><p class="meta">{p.status}</p><a class="link" href={'/projects/'+p.slug+'/'}>Read case study →</a></article>)}</div></div></section>
<section class="section alt"><div class="container prose"><h2>Search-led project evidence</h2><p>Each case study connects documented project experience to the services and questions clients commonly research before appointing a traffic, road safety or transport consultant. Search terms are used to describe relevant evidence, not to manufacture project claims.</p></div></section>
</Base>
---
import Base from '../../layouts/Base.astro';
import {projects} from '../../data/content';
const schema={'@context':'https://schema.org','@type':'ItemList',name:'ATRS Engineering Project Experience',itemListElement:projects.map((p,i)=>({'@type':'ListItem',position:i+1,name:p.title,url:'https://atrseng.co.ke/projects/'+p.slug+'/'}))};
---
<Base title="Projects" description="Selected ATRS traffic engineering, road safety, BRT, traffic impact assessment and transport project experience in Kenya, Somalia and East Africa." schema={schema}>
<section class="hero"><div class="container"><span class="eyebrow">Project experience</span><h1>Evidence from real traffic, safety and mobility assignments.</h1><p>Our project library is organised around the questions clients research before commissioning traffic engineering, road safety, BRT and development traffic work.</p></div></section>
<section class="section"><div class="container"><div class="notice" style="margin-bottom:28px"><strong>Evidence standard:</strong> Portfolio entries distinguish direct ATRS assignments from key-personnel experience. Unverified figures and unsupported claims are intentionally excluded.</div><div class="grid">{projects.map(p=><article class="card"><div class="meta"><span>{p.country}</span><span>·</span><span>{p.date}</span></div><span class="pill">{p.category}</span><h2 style="font-size:1.55rem">{p.title}</h2><p><strong>{p.client}</strong>{p.financier ? ' · '+p.financier : ''}</p><p>{p.summary}</p><p class="meta">{p.status}</p><a class="link" href={'/projects/'+p.slug+'/'}>Read case study →</a></article>)}</div></div></section>
<section class="section section-soft"><div class="container split"><div><span class="tag">Search-led structure</span><h2>Find the evidence behind the service.</h2><p>Every project connects to one or more ATRS service areas and to practical questions such as traffic forecasting, road safety assessment, BRT planning, traffic impact assessment and development access.</p></div><div class="stat-grid"><div class="stat"><strong>8</strong><span>case-study entries</span></div><div class="stat"><strong>3</strong><span>core portfolio themes</span></div><div class="stat"><strong>2+</strong><span>documented countries</span></div></div></div></section>
</Base>
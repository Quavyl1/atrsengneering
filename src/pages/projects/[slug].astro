---
import Base from '../../layouts/Base.astro'; import {projects} from '../../data/content'; export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}))}; const {project}=Astro.props;
---
<Base title={project.title} description={project.summary}><section class="hero"><div class="container"><p><a href="/projects/">Projects</a> / {project.title}</p><span class="eyebrow">{project.category}</span><h1>{project.title}</h1><p>{project.summary}</p></div></section><section class="section"><div class="container"><div class="factgrid"><div class="fact"><small>Client</small><strong>{project.client}</strong></div><div class="fact"><small>Country</small><strong>{project.country}</strong></div><div class="fact"><small>Date</small><strong>{project.date}</strong></div><div class="fact"><small>Category</small><strong>{project.category}</strong></div></div><div class="prose"><span class="tag">Case study</span><h2>Project brief</h2><p>{project.summary}</p><h3>Scope of services</h3><ul><li>Traffic and transport assessment inputs</li><li>Engineering analysis and technical reporting</li><li>Coordination of recommendations with project requirements</li></ul><h3>Key results</h3><p>Detailed results, figures and supporting evidence are subject to ATRS content verification before publication.</p><div class="pending"><strong>Verification note:</strong> No additional project claims are introduced beyond the available source material.</div></div></div></section></Base>
---
import Base from '../../layouts/Base.astro';
import {services,projects} from '../../data/content';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}))}
const {service}=Astro.props;
const related=projects.filter(p=>p.services.includes(service.slug));
const faqs=[
  {question:`What does ${service.title} cover?`,answer:service.summary},
  {question:'What are the typical deliverables?',answer:service.items.join('; ')+'.'},
  {question:`When should a client engage ATRS for ${service.title.toLowerCase()}?`,answer:'ATRS should be engaged early enough to define the evidence required, assess the relevant traffic or safety conditions and translate the findings into practical project decisions.'}
];
const serviceSchema={'@context':'https://schema.org','@type':'Service',name:service.title,description:service.summary,provider:{'@type':'Organization',name:'ATRS Engineering Consultants Limited',url:'https://atrseng.co.ke'},url:new URL(Astro.url.pathname,'https://atrseng.co.ke').href};
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faqs.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))};
---
<Base title={service.title} description={service.summary} schema={[serviceSchema,faqSchema]}>
<section class="hero"><div class="container"><p><a href="/services/">Services</a> / {service.title}</p><span class="eyebrow">{service.pillar}</span><h1>{service.title}</h1><p>{service.summary}</p></div></section>
<section class="section"><div class="container prose"><span class="tag">Service scope</span><h2>What this service covers</h2><p>ATRS applies a structured engineering approach to define the problem, establish the evidence base and develop recommendations that can be taken forward by clients and project teams.</p><h3>Typical deliverables</h3><ul>{service.items.map(i=><li>{i}</li>)}</ul><h3>Frequently asked questions</h3>{faqs.map(f=><div class="faq"><h4>{f.question}</h4><p>{f.answer}</p></div>)}</div></section>
{related.length>0 && <section class="section alt"><div class="container"><span class="eyebrow">Project evidence</span><h2>Related projects</h2><div class="grid">{related.map(p=><article class="card"><span class="pill">{p.category}</span><h3>{p.title}</h3><p>{p.summary}</p><a class="link" href={'/projects/'+p.slug+'/'}>View project →</a></article>)}</div></div></section>}
<section class="cta"><div class="container ctain"><div><h2>Need this expertise on your project?</h2><p>Send the scope, location and decision deadline.</p></div><a class="btn darkbtn" href="/contact/">Request a proposal →</a></div></section>
</Base>
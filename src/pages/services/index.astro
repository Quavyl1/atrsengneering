---
import Base from '../../layouts/Base.astro'; import {services} from '../../data/content';
const serviceListSchema={'@context':'https://schema.org','@type':'ItemList',name:'ATRS Engineering Services',itemListElement:services.map((s,i)=>({'@type':'ListItem',position:i+1,name:s.title,url:new URL('/services/'+s.slug+'/','https://atrseng.co.ke').href}))};
---
<Base title="Services" description="Traffic engineering, road safety engineering, traffic and road safety awareness, BRT, green mobility, and data and survey services." schema={serviceListSchema}>
<section class="hero"><div class="container"><span class="eyebrow">Services</span><h1>Traffic, road safety and awareness expertise.</h1><p>Six core service areas designed around evidence, safety and practical delivery.</p></div></section><section class="section"><div class="container"><div class="grid">{services.map(s=><article class="card"><span class="pill">{s.pillar}</span><h2 style="font-size:1.6rem">{s.title}</h2><p>{s.summary}</p><h3>Typical deliverables</h3><ul>{s.items.map(i=><li>{i}</li>)}</ul><a class="link" href={'/services/'+s.slug+'/'}>Service detail →</a></article>)}</div></div></section><section class="section alt"><div class="container"><span class="tag">Typical engagement</span><h2>From evidence to action</h2><div class="grid"><div class="card"><h3>01 · Understand</h3><p>Define the decision, corridor, development or programme and the evidence required.</p></div><div class="card"><h3>02 · Assess</h3><p>Collect, analyse and interpret the traffic, safety or awareness evidence.</p></div><div class="card"><h3>03 · Recommend</h3><p>Translate findings into practical engineering, operational or programme recommendations.</p></div></div></div></section></Base>
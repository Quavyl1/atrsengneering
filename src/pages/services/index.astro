---
import Base from '../../layouts/Base.astro';
import {services,projects} from '../../data/content';
import Icon from '../../components/Icon.astro';
const schema={'@context':'https://schema.org','@type':'ItemList',name:'ATRS Engineering Services',itemListElement:services.map((s,i)=>({'@type':'ListItem',position:i+1,name:s.title,url:'https://atrseng.co.ke/services/'+s.slug+'/'}))};
---
<Base title="Services" description="Traffic engineering, road safety, traffic and road safety awareness, BRT, green mobility and transport data services from ATRS Engineering Consultants." schema={schema}>
<section class="hero"><div class="container"><span class="eyebrow">Services</span><h1>Technical expertise for safer, more efficient movement.</h1><p>ATRS combines traffic evidence, engineering analysis and practical recommendations across six connected service areas.</p></div></section>
<section class="section"><div class="container"><div class="grid">{services.map(s=><article class="card"><div class="icon-row"><Icon name={s.slug==='traffic-engineering'?'traffic':s.slug==='road-safety-engineering'?'safety':s.slug==='public-transport-brt'?'transport':s.slug==='data-surveys-analysis'?'data':s.slug==='green-mobility'?'mobility':'awareness'}/><span class="pill">{s.pillar}</span></div><h2 style="font-size:1.65rem">{s.title}</h2><p>{s.summary}</p><h3>Typical deliverables</h3><ul>{s.items.map(i=><li>{i}</li>)}</ul><a class="link" href={'/services/'+s.slug+'/'}>Service details →</a></article>)}</div></div></section>
<section class="section section-soft"><div class="container split"><div><span class="tag">How we work</span><h2>Start with the decision, not the spreadsheet.</h2><p>We structure assignments around the decision the client needs to make: feasibility, design, access, capacity, safety, operations or implementation.</p></div><div class="grid" style="grid-template-columns:1fr 1fr"><div class="card"><Icon name="project"/><span class="pill">01</span><h3>Define</h3><p>Scope the problem and evidence.</p></div><div class="card"><Icon name="data"/><span class="pill">02</span><h3>Collect</h3><p>Build the field evidence base.</p></div><div class="card"><Icon name="traffic"/><span class="pill">03</span><h3>Analyse</h3><p>Assess demand, risk and performance.</p></div><div class="card"><Icon name="spark"/><span class="pill">04</span><h3>Recommend</h3><p>Translate findings into action.</p></div></div></div></section>
<section class="section"><div class="container"><span class="tag">Service evidence</span><h2>See the work behind the services.</h2><div class="grid" style="margin-top:30px">{projects.slice(0,6).map(p=><article class="card"><Icon name="project"/><div class="meta"><span>{p.country}</span><span>·</span><span>{p.status}</span></div><h3>{p.title}</h3><p>{p.summary}</p><a class="link" href={'/projects/'+p.slug+'/'}>View project →</a></article>)}</div></div></section>
</Base>